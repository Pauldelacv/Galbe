{
  "name": "galbe",
  "version": "0.1.0",
  "private": true,
  "description": "Galbe — an open-source, browser-based 3D design studio for graphic designers and art directors.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @galbe/studio dev",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "preview": "pnpm --filter @galbe/studio preview",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @galbe/studio test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
